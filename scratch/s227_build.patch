+                               "acc_wrap": wr["w"][0] / wr["w"][1] if wr["w"][1] else None, "n_wrap": wr["w"][1], "acc_nowrap": wr["n"][0] / wr["n"][1] if wr["n"][1] else None}
+    if was:
+        m.train(); prj.train()
+    return rec
